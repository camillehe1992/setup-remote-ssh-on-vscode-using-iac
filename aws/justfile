# justfile - Task runner for Terraform workflows
# Usage: just command
# Example:
# From root directory, run `just aws/pre-check`
# Or from aws directory, run `just pre-check`

# Project root directory (where the justfile is located)
PROJECT_ROOT := `pwd`

# Shell to use
set shell := ["bash", "-uc"]
set dotenv-load := true
set fallback := true

# Get cloud-provider
_get-cloud-provider:
	#!/usr/bin/env bash
	basename $(pwd)

# Get aws profile
_get-aws-profile:
    #!/usr/bin/env bash
    # Check if running in GitHub Actions
    if [ -n "$GITHUB_ACTIONS" ]; then
        # In GitHub Actions with OIDC, we don't use named profiles
        # The credentials are already set by configure-aws-credentials
        echo ""
    elif [ -f .env ]; then
        source .env && echo "${AWS_PROFILE:-app-deployer}"
    else
        echo "app-deployer"
    fi

# Pre Check cloud provider, aws profile
pre-check:
	#!/usr/bin/env bash
	echo "[*] Pre-checks..."
	CLOUD_PROVIDER=$(just _get-cloud-provider)
	AWS_PROFILE=$(just _get-aws-profile)

	echo "CLOUD_PROVIDER: ${CLOUD_PROVIDER}"
	echo "AWS_PROFILE: ${AWS_PROFILE}"
	AWS_PROFILE=${AWS_PROFILE} aws sts get-caller-identity | jq .

# Create a new key pair via AWS CLI
create-ssh-key:
	#!/usr/bin/env bash
	echo "[*] Creating a new key pair..."
	AWS_PROFILE=$(just _get-aws-profile)
	KEY_PAIR_NAME="aws-remote-ssh-on-vscode"
	aws ec2 create-key-pair --key-name ${KEY_PAIR_NAME} \
		--query 'KeyMaterial' \
		--profile ${AWS_PROFILE} \
		--output text > ${KEY_PAIR_NAME}.pem

	echo "[*] Setting permissions on the key pair file..."
	chmod 400 ${KEY_PAIR_NAME}.pem

	echo "[*] Moving the key pair file to the ~/.ssh/ directory..."
	mv ${KEY_PAIR_NAME}.pem ~/.ssh/${KEY_PAIR_NAME}.pem

	echo "[*] Listing existing key pairs..."
	aws ec2 describe-key-pairs --key-name ${KEY_PAIR_NAME} --profile ${AWS_PROFILE} | jq .

# Connect to your instance using the SSH command
ssh-connect:
	#!/usr/bin/env bash
	echo "[*] Connect to your instance using the SSH command"
	CMD=$(terraform output -raw ssh_command)
	echo $CMD

# Add instance to ~/.ssh/config file
add-ssh-config:
	#!/usr/bin/env bash
	echo "[*] Adding instance to ~/.ssh/config file..."
	INSTANCE_ID=$(terraform output -raw instance_id)
	PUBLIC_IP=$(terraform output -raw instance_public_ip)
	OS_USER=$(terraform output -raw instance_ssh_username)
	AWS_PROFILE=$(just _get-aws-profile)

	echo "Host aws-dev-instance" >> ~/.ssh/config
	echo "    HostName ${PUBLIC_IP}" >> ~/.ssh/config
	echo "    User ${OS_USER}" >> ~/.ssh/config
	echo "    IdentityFile ~/.ssh/aws-remote-ssh-on-vscode.pem" >> ~/.ssh/config

	cat ~/.ssh/config

# Update the security group rule for SSH access
update-ssh-ip:
	#!/usr/bin/env bash
	echo "[*] Updating security group rule for SSH access..."
	AWS_PROFILE=$(just _get-aws-profile)
	SECURITY_GROUP_ID=$(terraform output -raw security_group_id)
	bash ../scripts/update-ssh-ip.sh ${AWS_PROFILE} ${SECURITY_GROUP_ID}

# Generate Terraform Docs for AWS resources
gen-docs:
	#!/usr/bin/env bash
	CLOUD_PROVIDER=$(just _get-cloud-provider)
	echo "[*] Generating Terraform Docs for ${CLOUD_PROVIDER} resources..."
	for dir in */ ; do
		just ${dir%/}/gen-docs
	done
